---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { isoDate } from '../lib/content';
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { title, description, date, tags } = post.data;
---
<a class="post" href={`/blog/${post.id}`} data-filter-item data-tags={tags.join(' ')}>
  <time class="post__date" datetime={date.toISOString()}>{isoDate(date)}</time>
  <div>
    <h3 class="post__title">{title}</h3>
    <p class="post__excerpt">{description}</p>
    <div class="post__tags">{tags.map((t) => <span class="tag">#{t}</span>)}</div>
  </div>
  <Icon name="arrow-right" size="md" />
</a>
