---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
interface Props { project: CollectionEntry<'projects'>; index: number; wide?: boolean }
const { project, index, wide = false } = Astro.props;
const { title, summary, tags, featured, url } = project.data;
const kicker = String(index + 1).padStart(2, '0') + (featured ? ' · featured' : '');
const href = url ?? `/portfolio#${project.id}`;
---
<a
  id={project.id}
  class:list={['card', { 'card--feature': featured, 'span-2': wide }]}
  href={href}
  data-filter-item
  data-tags={tags.join(' ')}
>
  <span class:list={['label', { 'label--accent': !featured }]}>{kicker}</span>
  <Icon name="arrow-ne" size="md" class="card__arrow" />
  <h3 class="card__title">{title}</h3>
  <p class="card__body">{summary}</p>
  <div class="card__foot">{tags.map((t) => <span class="tag">{t}</span>)}</div>
</a>
