---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TagFilter from '../components/TagFilter.astro';
import { getProjects } from '../lib/content';

const projects = await getProjects();
const tags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();
---
<Base title="portfolio" description="Platform, GitOps and automation work by enrico Mostacci.">
  <section class="page-head">
    <span class="label label--accent">// 03 — portfolio</span>
    <h1 class="page-title">Portfolio<Icon name="arrow-ne" size="lg" /></h1>
    <p class="page-lead">Things I've built, run or fixed. Platform work is mostly invisible when it goes well, so each one says what it replaced.</p>
  </section>
  <TagFilter tags={tags} target="#projects" />
  <div class="grid-3" id="projects">
    {projects.map((p, i) => <ProjectCard project={p} index={i} wide={p.data.featured} />)}
  </div>
</Base>
